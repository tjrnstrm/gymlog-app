# Only needed for the scripts that talk to a hosted Supabase project (make-admin, find-user,
# tools/inspect-hosted, tools/schema-snapshot --remote, legacy/* --remote).
# The tests and the local import use the local Supabase stack and need none of this.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string of the hosted project (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# The old MongoDB, read-only, for legacy/import-mongo.ts and legacy/reconcile-mongo.ts
MONGO_URI=mongodb://127.0.0.1:27017/gymlog
