{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "tools/**/*.ts",
    "legacy/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
