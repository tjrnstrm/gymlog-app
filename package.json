{
  "name": "bro-split",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "db",
    "packages/*"
  ],
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/database/src/database.types.ts",
    "test": "npm run test --workspace db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspace frontend"
  },
  "devDependencies": {
    "supabase": "^2.119.0"
  }
}
